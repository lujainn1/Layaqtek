# Where the Node/Express backend is reachable from the device.
# Equivalent to the Flutter app's --dart-define=API_BASE_URL.
# Copy to .env.local and adjust. Leave unset to use the per-platform default
# (10.0.2.2:3001 on the Android emulator, localhost:3001 on the iOS simulator).

# Physical phone on the same Wi-Fi — run `ipconfig` to find your IP:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3001

# Deployed backend:
# EXPO_PUBLIC_API_BASE_URL=https://layaqtek.vercel.app
