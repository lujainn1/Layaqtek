{
  "expo": {
    "name": "لياقتك",
    "slug": "layaqtek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "layaqtek",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.layaqtek.app"
    },
    "android": {
      "package": "com.layaqtek.app",
      "adaptiveIcon": {
        "backgroundColor": "#16a34a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "يحتاج تطبيق لياقتك إلى الكاميرا لتحليل صور الطعام.",
          "photosPermission": "يحتاج تطبيق لياقتك إلى معرض الصور لتحليل صور الطعام."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": null
    }
  }
}
